# Klent — production credentials (mint at https://app.klent.dev/api-keys).
KLENT_API_KEY=ak_live_…
KLENT_BASE_URL=https://api.klent.dev/v1

# Anthropic — your prod or dev API key.
ANTHROPIC_API_KEY=sk-ant-…

# The "userland" Postgres standing in for ProdCorp's user database.
# Defaults to the local docker-compose Postgres (`docker compose up -d postgres`),
# in a separate database called `userland` so it never collides with Klent's own dev DB.
USERLAND_DATABASE_URL=postgres://klent:klent@localhost:5432/userland
