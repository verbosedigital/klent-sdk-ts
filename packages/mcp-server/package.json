{
  "name": "@klent/mcp-server",
  "version": "0.0.1-alpha.0",
  "license": "Apache-2.0",
  "description": "Model Context Protocol (MCP) server for Klent — let any MCP-aware client (Claude Desktop, Cursor, etc.) gate tool calls through Klent's policy engine.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "agents",
    "guardrails",
    "llm",
    "policy",
    "klent"
  ],
  "homepage": "https://klent.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verbosedigital/klent-sdk-ts.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/verbosedigital/klent-sdk-ts/issues"
  },
  "author": "Klent",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "klent-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@klent/schema": "workspace:*",
    "@klent/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@klent/tsconfig": "workspace:*",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
